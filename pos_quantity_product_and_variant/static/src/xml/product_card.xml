<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_stock_information.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-information-tag')]" position="after">
            <div t-if="this.pos.config.show_product_qty" class="position-absolute justify-content-between d-flex flex-row top-0 start-0 m-0 p-0">
                <div>
                    <t t-set="product_tmpl" t-value="pos.product_mapping[props.productId]" />
                    <t t-foreach="this.available_variants_product_tmpl_qty(props.productId)" t-as="product" t-key="product[0]">
                        <t t-set="orders_qty" t-value="this.order_product_qty[product[0]] || 0" />
                        <t t-set="product_info" t-value="this.pos.product_info[product[0].toString()]" />
                        <t t-if="product_info and product_info.type === 'consu'">
                            <t t-foreach="[[0, pos.config.show_on_hand_qty, product_info.qty_available], [1, pos.config.show_virtual_qty, product_info.virtual_available]]" t-as="selected_qty" t-key="product[0] + '_' + selected_qty[0]">
                                <t t-if="selected_qty[1]">
                                    <t t-set="available_qty" t-value="selected_qty[2] - orders_qty" />
                                    <span t-on-click="() => this.select_product_variant(product[0])" t-attf-class="ms-1 mt-1 me-1 badge rounded-pill {{available_qty &lt; 1 ? 'bg-danger' : 'bg-success'}}" >
                                        <b><span class="text-light" t-esc="available_qty"/></b>
                                        <t t-if="props.product.isConfigurable()">
                                            <a class="text-light">: </a>
                                            <div class="text-light" t-esc="product_info.variant_name"/>
                                        </t>
                                    </span>
                                </t>
                            </t>
                        </t>
                    </t>
                </div>
            </div>
        </xpath>
    </t>
</templates>
