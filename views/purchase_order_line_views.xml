<?xml version="1.0" encoding="utf-8" ?>
<odoo>
<record id="view_order_form_inherit_margin" model="ir.ui.view">
    <field name="name">purchase.order.form.margin</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='order_line']/list/field[@name='taxes_id']" position="after">

            <field name="margin_percentage" />
            <field name="mrp"/>
        </xpath>
    </field>
</record>
</odoo>
