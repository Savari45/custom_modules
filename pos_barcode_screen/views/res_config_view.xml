<odoo>
    <record id="res_config_settings_view_form_pos_barcode_screen" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_barcode_screen</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <div class="col-xs-12 col-md-6 o_setting_box" id="wk-barcode-screen">
                    <div class="o_setting_left_pane">
                        <field name="pos_show_barcode_screen"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="pos_show_barcode_screen"/>
                        <div class="text-muted">
                            Check this option to show barcode screen while scanning product
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
