<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_branch_company" model="ir.ui.view">
        <field name="name">stock.picking.form.branch.company</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_type_id']" position="after">
                    <field name="branch_company_id"/>
            </xpath>
              <xpath expr="//field[@name='origin']" position="after">
                    <field name="total_transfer_cost"/>
            </xpath>
               <!-- Add cost fields to move lines -->
        <xpath expr="//field[@name='move_ids_without_package']/list" position="inside">
            <field name="cost_price" optional="True"/>
            <field name="transfer_cost" optional="True"/>

        </xpath>
             <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_id']" position="after">
             <field name="display_name" optional="True"/>
             </xpath>
        </field>
    </record>
</odoo>
