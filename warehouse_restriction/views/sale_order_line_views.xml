<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_remove_product_domain" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.remove.product.domain</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Remove domain from order_line > form > product_id -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_template_id']" position="attributes">
               <attribute name="domain">[('id', 'in', allowed_product_ids)]</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//form//field[@name='product_id']" position="attributes">
                <attribute name="domain" remove="1"/>
            </xpath>

        </field>
    </record>
</odoo>